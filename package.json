{
  "name": "sa-opportunity-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test",
    "db:migrate:local": "wrangler d1 migrations apply careeropportunities --local --config wrangler.jsonc",
    "validate": "npm run check && npm test && npm run db:migrate:local && npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3",
    "wrangler": "4.161.0"
  }
}
