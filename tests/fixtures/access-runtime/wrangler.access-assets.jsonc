{
  "name": "saop-access-fixture-assets",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "access": {
    "dev": {
      "aud": "saop-local-feasibility-test",
      "identity": {
        "email": "access-test@example.invalid",
        "name": "Local Access Test"
      }
    }
  }
}
