<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A carefully maintained directory of South African education, skills and career opportunities." />
    <title>South African Opportunity Platform</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">South African Opportunity Platform</p>
      <h1>Find your next opportunity.</h1>
      <p>
        A structured directory for learnerships, internships, apprenticeships,
        bursaries and graduate programmes.
      </p>
      <p class="notice">
        The platform foundation is being built. Listings will appear only after
        human verification and editorial approval.
      </p>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f7f8fa;
    color: #172033;
    font-family: system-ui, sans-serif;
  }
  main {
    width: min(100% - 2rem, 48rem);
    margin: 0 auto;
    padding: clamp(4rem, 12vh, 8rem) 0;
  }
  .eyebrow {
    color: #385b91;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 12ch;
    margin: 1rem 0;
    font-size: clamp(2.5rem, 9vw, 4.5rem);
    line-height: 1.04;
  }
  main > p:not(.eyebrow) {
    max-width: 42rem;
    color: #46536a;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .notice {
    margin-top: 2rem;
    padding: 1rem;
    border-left: 4px solid #7890b5;
    background: #edf1f7;
    font-size: 0.95rem !important;
  }
</style>
